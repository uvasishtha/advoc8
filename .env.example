# Advoc8 environment
#
# Copy to .env.local and fill in. Every value here is optional: without an API
# key the app still runs, and the two AI features fall back to generating
# questions from the report's own numbers and running a scripted rehearsal.

# Supabase. Copy to .env.local. Turn on Anonymous Sign-Ins in
# Authentication → Providers, so the app can create a user with no login screen.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Enables question generation and practice chat. Get one at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash